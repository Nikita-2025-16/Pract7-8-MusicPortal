@page
@model MusicPortal.Pages.PlaylistCalcModel
@{
    ViewData["Title"] = "Калькулятор плейлиста";
}

<div class="container mt-4">
    <h2>Калькулятор загальної тривалості</h2>

    <div class="card shadow-sm mt-3" style="max-width: 500px;">
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Кількість треків</label>
                    <input type="number" class="form-control" asp-for="TracksCount" min="0" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Середня тривалість одного треку (в сек)</label>
                    <input type="number" class="form-control" asp-for="AverageDuration" min="0" required />
                </div>
                <button type="submit" class="btn btn-primary">Розрахувати</button>
            </form>

            @if (!string.IsNullOrEmpty(Model.ResultMessage))
            {
                <div class="alert alert-success mt-4 mb-0">
                    @Model.ResultMessage
                </div>
            }
        </div>
    </div>
</div>